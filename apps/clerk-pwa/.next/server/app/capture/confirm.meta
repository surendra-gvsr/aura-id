{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/capture/layout,_N_T_/capture/confirm/layout,_N_T_/capture/confirm/page,_N_T_/capture/confirm"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/capture/confirm/__PAGE__",
    "/capture/confirm",
    "/capture",
    "/_index",
    "/_head"
  ]
}